{
  "manifest_version": 3,
  "name": "WatchTower",
  "version": "1.0.0",
  "description": "A basic example extension with only required keys",
  "action": {},
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "scripting",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open_side_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Ctrl+Shift+Y"
      },
      "description": "Opens the side panel"
    }
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "1": "/icon-1.png"
   }

}